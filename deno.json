{
  "name": "@hiisi/viola-publish-lints",
  "version": "0.1.0",
  "description": "Viola lints for the metadata a package needs to be published and installed, on jsr, npm and crates.io.",
  "license": "MPL-2.0",
  "exports": {
    ".": "./mod.ts",
    "./manifest": "./src/manifest.ts"
  },
  "publish": {
    "include": [
      "mod.ts",
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*_test.ts",
      "tests/**"
    ]
  },
  "imports": {
    "@hiisi/viola": "jsr:@hiisi/viola@^0.3.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/toml": "jsr:@std/toml@^1",
    "@hiisi/viola-default-lints": "jsr:@hiisi/viola-default-lints@^0.3.1",
    "@hiisi/viola-grammar-ts": "jsr:@hiisi/viola-grammar-ts@^0.3.1"
  },
  "tasks": {
    "check": "deno check mod.ts src/manifest.ts",
    "test": "deno test --allow-read --allow-write",
    "lint": "deno run -A --min-dep-age=0 jsr:@hiisi/viola-cli@^0.3.1 --project . --include .",
    "fmt": "deno fmt"
  },
  "test": {
    "include": [
      "tests/"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2
  },
  "minimumDependencyAge": 0
}
